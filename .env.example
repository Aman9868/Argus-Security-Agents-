# Cyber Sentinel Multi-Agent API Configuration
API_HOST=127.0.0.1
API_PORT=8001
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_FOR_PROD

# Redis Cache & Tool Idempotency Store
REDIS_URL=redis://127.0.0.1:6379/0

# LLM Gateway Configuration
LLM_PROVIDER=groq
# --- Google Gemini (Fallback Provider #1) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_PROJECT_ID=
GEMINI_PROJECT_NO=

# --- Groq (Primary Provider) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_ROUTING_MODEL=openai/gpt-oss-20b
GROQ_REASONING_MODEL=openai/gpt-oss-120b

# LangSmith Tracing & Observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=cyber-agent-prod

# External Threat Intelligence APIs (Free Tiers / Optional)
VIRUSTOTAL_API_KEY=
OTX_API_KEY=
SHODAN_API_KEY=
NVD_API_KEY=

# Rate Limiting & Safety Thresholds
RATE_LIMIT_IP_PER_MINUTE=100
CONTAINMENT_HITL_THRESHOLD=0.75

